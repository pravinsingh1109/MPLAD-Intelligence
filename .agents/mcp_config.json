{
  "mcpServers": {
    "21st": {
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${API_KEY_21ST}"
      },
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://21st.dev/api/mcp",
        "--header",
        "x-api-key: ${API_KEY_21ST}"
      ],
      "env": {
        "x-api-key": "${API_KEY_21ST}"
      }
    }
  }
}
